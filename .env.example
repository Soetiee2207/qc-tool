# Mẫu cấu hình môi trường — COPY thành `.env` rồi điền giá trị thật.
#
#   cp .env.example .env
#
# File `.env` đã được gitignore. KHÔNG BAO GIỜ commit `.env`.
# File này (.env.example) thì commit được — nó chỉ chứa tên biến, không chứa giá trị thật.

# ── Môi trường được test ─────────────────────────────────────────────────────
QCTOOL_BASE_URL=https://dev-qc-portal.datafactory.fit

# ── Xác thực ─────────────────────────────────────────────────────────────────
# Chế độ:
#   browser   — mở trình duyệt thật, đăng nhập qua form của IdP. **Chế độ duy
#               nhất được phép tự đăng nhập**, và là chế độ dùng để test UI/UX.
#   password  — tool tự đăng nhập lấy token qua OIDC (dev/CI, cần user thật)
#   token     — anh dán sẵn token vào QCTOOL_BEARER_TOKEN
#   manual    — KHÔNG xác thực. Không tự đăng nhập dù có tài khoản ở dưới.
QCTOOL_AUTH_MODE=browser

# Dùng khi QCTOOL_AUTH_MODE=browser hoặc =password
QCTOOL_USERNAME=
QCTOOL_PASSWORD=

# Dùng khi QCTOOL_AUTH_MODE=token
QCTOOL_BEARER_TOKEN=

# ── OIDC (nếu hệ thống đăng nhập qua Keycloak) ───────────────────────────────
QCTOOL_OIDC_ISSUER=https://auth.datafactory.fit/realms/vd-dev
QCTOOL_OIDC_CLIENT_ID=vd-portal

# ── Tham số chạy ─────────────────────────────────────────────────────────────
QCTOOL_TIMEOUT_SECONDS=30
QCTOOL_VERIFY_SSL=true

# ── LLM cho agent (bật trong project bằng `llm: true` hoặc `--llm`) ──────────
# Có key KHÔNG tự bật LLM. Provider phải hỗ trợ OpenAI-compatible tool calling.
QCTOOL_LLM_ENABLED=false
QCTOOL_LLM_BASE_URL=https://api.deepseek.com/v1
QCTOOL_LLM_API_KEY=
QCTOOL_LLM_MODEL=deepseek-chat
QCTOOL_LLM_TIMEOUT_SECONDS=90
# DeepSeek: `disabled` = tool calling không reasoning (nhanh, rẻ hơn). Bỏ trống = mặc định provider.
QCTOOL_LLM_THINKING=disabled
